#!/bin/bash
#SBATCH --job-name=DANDI-Verify-Checksums
#SBATCH --partition mit_preemptable
#SBATCH --requeue
#SBATCH --array 0-15%4
#SBATCH --mem=1GB
#SBATCH --cpus-per-task 1
#SBATCH --time=12:00:00
#SBATCH --open-mode=append
#SBATCH --output=/orcd/data/dandi/001/backup/logs/verify_checksums_batch_%A_%a.out
#SBATCH --error=/orcd/data/dandi/001/backup/logs/verify_checksums_batch_%A_%a.err

# Verifies the content of the blob mirror against the bucket, one task per first hex digit of the
# content ID, as the blob backup copies it (see `s3backup dandi verify-checksums --help`). Each blob's
# checksum is cached beside it, with the date it was computed, so a task that times out or is preempted
# loses nothing: the next run reads only what is left. The first run reads the whole mirror and takes
# several. Later ones read the blobs copied or changed since, and those whose checksum is 90 days old
# (the CLI's default for --rehash-older-than, so it is not passed here), to catch damage that leaves the
# modification time alone: blobs never read first, then the longest-unread. At most 4 tasks run at once,
# so as not to take the partitions' whole read bandwidth from the jobs that use them.
#
# Reading the whole mirror (about 1.34 PB) every 90 days is about 170 MB/s around the clock. Each task's
# summary, printed also when SLURM stops it at the time limit, gives its read rate and how many blobs
# are still overdue; if that number keeps growing from one run to the next, this job does not keep up.
#
# A copy that does not match the bucket is deleted, with its cached checksum, and the next blob
# backup copies it afresh, as it copies any blob that is missing. The task then exits 3, which the runner's Check backup workflow reports as a checksum
# mismatch, naming each blob from the `[MISMATCH DELETED]` lines of this log. It exits 1 when part of the
# bucket could not be listed or a copy could not be deleted. To copy the blobs again at once instead:
#     s3backup dandi verify-checksums <task_id> --repair
#
# The log directory must exist before submission; create it once with:
#     mkdir -p /orcd/data/dandi/001/backup/logs

source /etc/profile.d/modules.sh  # When run via crontab, this is needed to load the modules
module load miniforge
conda activate /orcd/data/dandi/001/environments/name-s3+backup_env

# Only after the setup above, which reads variables cron does not set (see
# backup_blobs_batch_deployment.sh).
set -uo pipefail

task_id="${SLURM_ARRAY_TASK_ID}"
echo "$(date --iso-8601=seconds) starting verify_checksums task ${task_id} (job ${SLURM_ARRAY_JOB_ID:-?} on $(hostname))"

# A task of the previous day's array can still be verifying the same head, during the first runs
# especially. Two would only read the same files, so this one leaves it to that one.
lock_file="/orcd/data/dandi/001/backup/flocks/verify_checksums_batch_${task_id}.lock"
exec {lock_fd}>"${lock_file}"
if ! flock --nonblocking "${lock_fd}"; then
    echo "$(date --iso-8601=seconds) task ${task_id}: another run still holds ${lock_file} and is verifying this head; leaving it to that one."
    exit 0
fi

s3backup dandi verify-checksums "${task_id}"
status=$?

if [ "${status}" -eq 3 ]; then
    echo "$(date --iso-8601=seconds) task ${task_id}: deleted the copies that do not match the bucket, named in the [MISMATCH DELETED] lines above; the next blob backup copies them again." >&2
elif [ "${status}" -ne 0 ]; then
    echo "$(date --iso-8601=seconds) ERROR task ${task_id}: 's3backup dandi verify-checksums ${task_id}' exited with status ${status}; the summary above names each blob that does not match." >&2
else
    echo "$(date --iso-8601=seconds) completed verify_checksums task ${task_id}"
fi

exit "${status}"
[exit 0]

