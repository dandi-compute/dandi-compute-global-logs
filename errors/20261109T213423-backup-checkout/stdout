+#SBATCH --job-name=DANDI-Backup-Blobs
 #SBATCH --partition mit_preemptable
+#SBATCH --requeue
 #SBATCH --array 0-15
 #SBATCH --mem=1GB
 #SBATCH --cpus-per-task 1
