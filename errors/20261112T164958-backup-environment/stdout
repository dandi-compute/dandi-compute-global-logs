$ cat /tmp/tmp.IHhGR0CKXs
trap 'echo "!!! exit $? from: $BASH_COMMAND" >&2' ERR
set -x
source /etc/profile.d/modules.sh  # When run via crontab, this is needed to load the modules
module load miniforge
conda activate /orcd/data/dandi/001/environments/name-s3+backup_env
set -uo pipefail
task_id="${SLURM_ARRAY_TASK_ID}"
echo "$(date --iso-8601=seconds) starting backup_blobs task ${task_id} (job ${SLURM_ARRAY_JOB_ID:-?} on $(hostname))"
lock_file="/orcd/data/dandi/001/backup/flocks/backup_blobs_batch_${task_id}.lock"
exec {lock_fd}>"${lock_file}"
if ! flock --nonblocking "${lock_fd}"; then
    echo "$(date --iso-8601=seconds) ERROR task ${task_id}: could not acquire lock ${lock_file}; another run is still active. Refusing to skip silently." >&2
    exit 1
fi
set +x
echo "--- after the setup"
echo "CONDA_PREFIX=${CONDA_PREFIX:-}"
echo "PATH=$PATH"
type s3backup s5cmd python flock
echo "--- s3backup dandi blobs --help"
s3backup dandi blobs --help
echo "--- the package s3backup runs"
python -c 'import simple_s3_backup._base as base, simple_s3_backup; print(simple_s3_backup.__file__)'
echo "--- s5cmd"
s5cmd version
echo "--- listing a blob prefix with the job's credentials"
s5cmd ls 's3://dandiarchive/blobs/482/5cf/*'
echo "--- the same without signing"
s5cmd --no-sign-request ls 's3://dandiarchive/blobs/482/5cf/*'
[exit 0]

